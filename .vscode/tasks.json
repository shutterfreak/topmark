{
  // VS Code tasks for common validation workflows from the Command Palette.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Make: Verification checks",
      "type": "shell",
      "command": "make verify",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Make: Format checks",
      "type": "shell",
      "command": "make format-check",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Make: Lint",
      "type": "shell",
      "command": "make lint",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Make: Documentation hygiene",
      "type": "shell",
      "command": "make docs-hygiene",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Make: Code hygiene",
      "type": "shell",
      "command": "make code-hygiene",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Nox: Smoke tests",
      "type": "shell",
      "command": "uv run --extra dev nox -s smoke",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Nox: QA (all supported Python versions)",
      "type": "shell",
      "command": "uv run --extra dev nox -s qa",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Nox: Coverage",
      "type": "shell",
      "command": "uv run --extra dev nox -s coverage",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Nox: Pre-PR validation (recommended)",
      "type": "shell",
      "command": "uv run --extra dev nox -s pre_pr",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
